# Enable YouTube Data API v3 for this key. It is required for playlist timestamps.
# Never commit a real key or cookie file. Restrict the key to the YouTube API.
YT_API_KEY=

# Periodic re-sync of monitored sources. 0 disables it. Failed one-offs require manual retry.
SYNC_INTERVAL_HOURS=6
# Cost guard for this app only. Reserve headroom for other clients sharing the API project.
YT_DAILY_BUDGET=9000
# Preserve source order, including duplicate entries. Alternative: discovery
PLAYLIST_ORDER=source

# Working downloader options are unchanged.
YT_PLAYER_CLIENTS=
YT_DLP_COOKIES_FILE=
DOWNLOAD_SLEEP_MIN=2
DOWNLOAD_SLEEP_MAX=6

# Install the newest pre-release/nightly into a new venv daily, without restarting the API.
YTDLP_UPDATE_ENABLED=true
YTDLP_UPDATE_TIME=04:00
TZ=Europe/Paris

# Optional custom configuration, mounted read-only inside the container:
# BEETS_CONFIG=/app/beets.yaml
# AcoustID lookups use beets' application key; no submission user key is needed.
