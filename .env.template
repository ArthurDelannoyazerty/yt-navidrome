# Required: YouTube Data API v3. Restrict this key to that API.
YT_API_KEY=

# Periodic source synchronization. 0 disables it.
SYNC_INTERVAL_HOURS=6
YT_DAILY_BUDGET=9000
PLAYLIST_ORDER=source

# Daily lightweight library verification. 0 disables it.
INTEGRITY_INTERVAL_HOURS=24

# Existing downloader options remain unchanged.
YT_PLAYER_CLIENTS=
YT_DLP_COOKIES_FILE=
DOWNLOAD_SLEEP_MIN=2
DOWNLOAD_SLEEP_MAX=6
# Stop automatic downloads after this many failed attempts. Metadata retries and
# waits for the shared YouTube cooldown do not consume this budget.
DOWNLOAD_MAX_ATTEMPTS=5

# Shared YouTube anti-bot/403 circuit breaker. After repeated blocks, queued
# YouTube downloads are deferred instead of hammering the playback endpoint.
YT_CIRCUIT_FAILURES=3
YT_CIRCUIT_WINDOW_SECONDS=300
YT_CIRCUIT_COOLDOWN_SECONDS=900
YT_CIRCUIT_MAX_COOLDOWN_SECONDS=3600

# Isolated nightly yt-dlp runtime update.
YTDLP_UPDATE_ENABLED=true
YTDLP_UPDATE_TIME=04:00
# Public Spotify scans and audio matching have their own isolated runtime.
SPOTDL_UPDATE_ENABLED=true
SPOTDL_UPDATE_TIME=04:30
TZ=Europe/Paris

# Optional custom config mounted read-only:
# BEETS_CONFIG=/app/beets.yaml

# Optional account browsing/private-playlist access. Public Spotify URLs need
# no connection or client ID. PKCE uses no client secret.
# Create an app in the Spotify Developer Dashboard and register this exact URL.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
# Example behind your authenticated HTTPS proxy:
# SPOTIFY_REDIRECT_URI=https://ingestor.example.com/api/spotify/callback
# Local development: http://127.0.0.1:8008/api/spotify/callback (not localhost)
