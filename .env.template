# Required: YouTube Data API v3. Restrict this key to that API.
YT_API_KEY=

# Periodic source synchronization. 0 disables it.
SYNC_INTERVAL_HOURS=6
YT_DAILY_BUDGET=9000
PLAYLIST_ORDER=source

# Daily lightweight library verification. 0 disables it.
INTEGRITY_INTERVAL_HOURS=24

# Existing downloader options remain unchanged.
YT_PLAYER_CLIENTS=
YT_DLP_COOKIES_FILE=
DOWNLOAD_SLEEP_MIN=2
DOWNLOAD_SLEEP_MAX=6

# Isolated nightly yt-dlp runtime update.
YTDLP_UPDATE_ENABLED=true
YTDLP_UPDATE_TIME=04:00
TZ=Europe/Paris

# Optional custom config mounted read-only:
# BEETS_CONFIG=/app/beets.yaml
