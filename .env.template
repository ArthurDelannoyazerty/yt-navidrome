
# --- Metadata APIs ---
ACOUSTID_API_KEY=                                         # https://acoustid.org/api-key
YT_API_KEY=                  # Google Cloud -> YouTube Data API v3 (1 unit/call, 10k/day)

# --- Spotify (create app at developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Downloader resilience ---
YT_PLAYER_CLIENTS=
YT_COOKIES_FILE=         # optional cookies.txt from a THROWAWAY account: ~2000 vid/hr vs ~300 guest
DOWNLOAD_SLEEP_MIN=2         # jittered anti-bot pacing between downloads
DOWNLOAD_SLEEP_MAX=6
MAX_CONCURRENT_TRACKS=3
ACOUSTID_MIN_INTERVAL=0.4    # AcoustID hard limit: 3 req/s

# --- Cobalt fallback (SELF-HOSTED; public instance requires paid key) ---
COBALT_API_URL=http://localhost:9090/              # e.g. http://localhost:9090/
COBALT_API_KEY=

# --- Search strategy ---
YTM_SEARCH_MODE=music        # "music" = music.youtube.com songs tab; "ytsearch" = plain ytsearch1:

# --- Storage ---
NAVIDROME_LIB_DIR=./navidrome_library
LIBRARY_DB=library.db

# --- Scheduler : 0 = off ---
SYNC_INTERVAL_HOURS=0